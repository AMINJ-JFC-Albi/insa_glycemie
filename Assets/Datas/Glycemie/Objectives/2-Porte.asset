  objectiveId: Door
  title: "D\xE9verrouiller la porte s\xE9curis\xE9e du bureau"
  conversationName: Entrer dans le bureau
  conversationAvatar: {fileID: 0}
  conversation:
  - sender: 0
    messageId: 2-1
    content: "Commence par regarder le post-it \xE0 c\xF4t\xE9 de la porte du bureau."
  - sender: 0
    messageId: 2-2
    content: Maintenant, fouille bien le labo. La notice est en plusieurs morceaux,
      rassemble les.
  - sender: 0
    messageId: 2-3
    content: "Suis les \xE9tapes de la notice dans l\u2019ordre. C\u2019est important."
  - sender: 0
    messageId: 2-4
    content: "Renseigne le nom du faux patient, tu le trouveras \xE9crit sur la porte."
  - sender: 0
    messageId: 2-5
    content: "D\xE9finit la fr\xE9quence de mise \xE0 jour, elle est indiqu\xE9e
      sur la notice du capteur."
  - sender: 0
    messageId: 2-6
    content: "Mets le nom du m\xE9decin, il t'a \xE9crit tout \xE0 l'heure, va voir
      le nom du contacte si tu as oubli\xE9"
